# Development defaults from docker-compose.yml; do not use these credentials in production.
DATABASE_URL=postgres://tcg_user:tcg_password@localhost:5432/tcg_tracker

# HTTP ports for the API server (HTTP/1.1 + HTTP/2 h2c)
PORT=3000
HTTP2_PORT=3001

# Keycloak (realm "tcg-card-stack" is imported from keycloak/realm-export.json)
KEYCLOAK_ISSUER=http://localhost:8080/realms/tcg-card-stack
KEYCLOAK_AUDIENCE=tcg-api
# Optional; derived from KEYCLOAK_ISSUER when unset
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/tcg-card-stack/protocol/openid-connect/certs
