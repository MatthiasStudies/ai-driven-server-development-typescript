meta {
  name: Create grading certificate
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/cards/{{cardId}}/grading-certificate
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "gradingCompany": "PSA",
    "certNumber": "BRUNO-SAMPLE-001",
    "grade": 9.5,
    "gradedAt": "2024-01-01"
  }
}

docs {
  Creates data. Use an owned ungraded card and a unique certNumber. Repeating the request should return 409; one certificate is allowed per card and certNumber is unique.
}
