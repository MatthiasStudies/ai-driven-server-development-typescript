meta {
  name: Conditional GET card
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/cards/{{cardId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  If-None-Match: {{cardEtag}}
}

docs {
  First run Get card to capture an ETag. An unchanged representation should return 304.
}
