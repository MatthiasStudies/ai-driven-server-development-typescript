meta {
  name: Get card and capture ETag
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/cards/{{cardId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const etag = res.getHeader("etag");
  if (res.getStatus() === 200 && etag) bru.setEnvVar("cardEtag", etag);
}

docs {
  Run after changing cardId and before conditional GET or PUT. The current ETag, including quotes, is saved in the environment.
}
