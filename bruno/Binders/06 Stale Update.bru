meta {
  name: Stale binder update (412)
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/binders/{{binderId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
  If-Match: "deliberately-stale-etag"
}

body:json {
  {
    "name": "Stale binder update",
    "description": "This should not overwrite the current version"
  }
}

docs {
  Expects 412 for an existing owned binder. The supplied ETag is deliberately different from the server's current ETag.
}
