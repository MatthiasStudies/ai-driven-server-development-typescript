meta {
  name: Get binder and capture ETag
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/binders/{{binderId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

script:post-response {
  const etag = res.getHeader("etag");
  if (res.getStatus() === 200 && etag) bru.setEnvVar("binderEtag", etag);
}

docs {
  Run this after changing binderId and before conditional GET or PUT. It stores the current ETag, including quotes.
}
