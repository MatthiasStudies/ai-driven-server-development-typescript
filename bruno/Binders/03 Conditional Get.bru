meta {
  name: Conditional GET binder
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/binders/{{binderId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  If-None-Match: {{binderEtag}}
}

docs {
  First run Get binder to capture an ETag. An unchanged representation should return 304.
}
